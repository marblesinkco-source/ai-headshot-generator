# =============================================================================
# TailorPic — Environment Variables
# =============================================================================
# Copy to .env.local (development) or .env (Docker).
#
# Plan 1 (Managed):  Fill Supabase + Paddle + Replicate + Resend sections
# Plan 2 (Hybrid):   Same as Plan 1, plus Docker/VPS sections
# Plan 3 (Full):     Replace Supabase with self-hosted DB, add GPU config
# =============================================================================

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://www.tailorpic.com

# ── Supabase (Plan 1 — Auth + Database + Storage) ───────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Paddle (Payments — Merchant of Record) ──────────────────────────────────
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_ENV=sandbox
# Optional: Paddle discount IDs (create in Paddle Dashboard)
# PADDLE_DISCOUNT_UPGRADE25=dsc_...
# PADDLE_DISCOUNT_AVATARBUNDLE=dsc_...
# PADDLE_DISCOUNT_AVATAR20=dsc_...

# ── Stripe (LEGACY — only needed for historical transaction lookups) ─────────
# These are optional. Set them only if you need to query old Stripe orders
# from the accounting center. All new payments go through Paddle above.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# ── AI Provider — Replicate (Plan 1 & 2) ────────────────────────────────────
REPLICATE_API_TOKEN=
REPLICATE_WEBHOOK_SECRET=

# ── Email — Resend (all plans) ───────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=noreply@tailorpic.com

# ── Redis / Upstash (Rate limiting & caching) ───────────────────────────────
# Plan 1: Upstash Redis (managed)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Plan 2/3: Local Redis (self-hosted Docker)
# REDIS_URL=redis://redis:6379

# ── Storage (if using external S3-compatible instead of Supabase Storage) ───
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ── Analytics (optional) ─────────────────────────────────────────────────────
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=

# ── Cron Security ────────────────────────────────────────────────────────────
CRON_SECRET=

# ── Test Mode ────────────────────────────────────────────────────────────────
TEST_MODE=false
TEST_USER_EMAILS=

# =============================================================================
# Plan 2/3 — Docker / VPS Settings
# =============================================================================

# ── Docker Ports ─────────────────────────────────────────────────────────────
# APP_PORT=3000
# DB_PORT=5432
# REDIS_PORT=6379

# ── Self-hosted PostgreSQL (Plan 3 — replaces Supabase) ─────────────────────
# POSTGRES_DB=tailorpic
# POSTGRES_USER=tailorpic
# POSTGRES_PASSWORD=

# ── Self-hosted GPU (Plan 3 — replaces Replicate) ───────────────────────────
# GPU_INFERENCE_URL=http://gpu-server:8000
# GPU_MODEL_PATH=/models/flux-headshot
# GPU_DEVICE=cuda:0

# =============================================================================
# Infrastructure Provider Selection
# =============================================================================
# Switch between managed and self-hosted by changing these:
#
# INFRA_DB=supabase         # supabase | postgres
# INFRA_CACHE=upstash       # upstash | redis
# INFRA_STORAGE=supabase    # supabase | s3
# INFRA_AI=replicate        # replicate | self-hosted
# INFRA_EMAIL=resend        # resend | ses | smtp
